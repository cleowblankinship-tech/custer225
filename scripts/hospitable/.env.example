# Copy this file to `.env` (in this same folder) and fill in your values.
# The `.env` file is gitignored — it will NOT be committed.

# Your restricted-user Hospitable login (the account Josh gave you)
HOSPITABLE_EMAIL=cleo.w.blankinship@gmail.com
HOSPITABLE_PASSWORD=your-password-here

# Usually leave this as-is. If Hospitable's login lives at a different URL,
# put the exact login page URL here.
HOSPITABLE_LOGIN_URL=https://my.hospitable.com/login

# Leave false for the proof-of-concept so a browser window opens and you can
# watch it work. Set to true later for unattended runs.
HEADLESS=false
